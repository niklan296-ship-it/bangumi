<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w_bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/w_mark" android:gravity="center"
            android:text="番" android:textColor="#FF1E1400" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:textColor="#FFF4F3FA" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFB81C" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:layout_marginTop="6dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/r0_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFF4F3FA" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/r0_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFA09FB8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/r0_btn" android:layout_width="44dp" android:layout_height="34dp" android:layout_marginStart="10dp"
                android:gravity="center" android:background="@drawable/w_btn" android:textColor="#FF1E1400" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/r1_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFF4F3FA" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/r1_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFA09FB8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/r1_btn" android:layout_width="44dp" android:layout_height="34dp" android:layout_marginStart="10dp"
                android:gravity="center" android:background="@drawable/w_btn" android:textColor="#FF1E1400" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/r2_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFF4F3FA" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/r2_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFA09FB8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/r2_btn" android:layout_width="44dp" android:layout_height="34dp" android:layout_marginStart="10dp"
                android:gravity="center" android:background="@drawable/w_btn" android:textColor="#FF1E1400" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFA09FB8" android:textSize="13sp" android:gravity="center" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFB81C" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
