{
  "name": "Бангуми — аниме-список и расписание",
  "short_name": "Бангуми",
  "description": "Мой список аниме, счётчик серий и расписание выхода",
  "lang": "ru",
  "start_url": "./#schedule",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#10122A",
  "theme_color": "#10122A",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Быстро в расписание",
      "short_name": "В план",
      "url": "./?quick=1",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Расписание",
      "url": "./#schedule"
    },
    {
      "name": "Мой список",
      "url": "./#list"
    },
    {
      "name": "Поиск",
      "url": "./#search"
    }
  ],
  "id": "./",
  "display_override": [
    "standalone"
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}